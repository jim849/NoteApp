# Generate a local value with: openssl rand -hex 32
# Copy this file to .env and replace the placeholder before starting the app.
EXPORT_HMAC_KEY=replace-with-a-random-local-key
# Generate a DIFFERENT key once with: openssl rand -hex 32
# Keep this stable and backed up; changing it prevents decryption of old comments.
COMMENT_ENCRYPTION_KEY=replace-with-64-hex-characters
